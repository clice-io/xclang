+/// Write the spelling of a string literal. Only a raw string literal holds
+/// line breaks: each \r\n is written as \n, which is what it means in the
+/// literal (StringLiteralParser), so that compiling the output gives the same
+/// string even through a text-mode stream, which would make it \r\r\n; and
+/// the lines the literal spans are counted, so that the tokens after it keep
+/// their line numbers.
+void PrintPPOutputPPCallbacks::WriteStringLiteral(StringRef Spelling) {
+  if (Spelling.find_first_of("\r\n") == StringRef::npos) {
+    OS->write(Spelling.data(), Spelling.size());
+    return;
+  }
+  HandleNewlinesInToken(Spelling.data(), Spelling.size());
+  for (size_t Pos; (Pos = Spelling.find("\r\n")) != StringRef::npos;) {
+    OS->write(Spelling.data(), Pos);
+    Spelling = Spelling.substr(Pos + 1);
+  }
+  OS->write(Spelling.data(), Spelling.size());
+}
