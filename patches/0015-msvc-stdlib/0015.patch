@@ -0,0 +1,52 @@
+// The C++ standard library of MSVC targets: Microsoft's STL, from the
+// system's headers, unless -stdlib=libc++; then libc++ installed with the
+// compiler, include/<triple>/c++/v1 and include/c++/v1, before them.
+
+// RUN: rm -rf %t && mkdir -p %t/bin %t/include/c++/v1 %t/include/x86_64-pc-windows-msvc/c++/v1
+
+// RUN: %clang -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -stdlib=libc++ -fsyntax-only %s 2>&1 | FileCheck --check-prefix=LIBCXX %s
+// RUN: %clang_cl -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   /clang:-stdlib=libc++ /Zs -- %s 2>&1 | FileCheck --check-prefix=LIBCXX %s
+// LIBCXX: InstalledDir: [[INSTALLDIR:.+$]]
+// LIBCXX: "-internal-isystem" "[[INSTALLDIR]]{{/|\\\\}}..{{/|\\\\}}include{{/|\\\\}}x86_64-pc-windows-msvc{{/|\\\\}}c++{{/|\\\\}}v1"
+// LIBCXX-SAME: "-internal-isystem" "[[INSTALLDIR]]{{/|\\\\}}..{{/|\\\\}}include{{/|\\\\}}c++{{/|\\\\}}v1"
+// LIBCXX-SAME: "-internal-isystem" "{{[^"]*}}{{/|\\\\}}include"
+
+// Another target has no headers of its own there: the shared ones only.
+// RUN: %clang -### --target=aarch64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -stdlib=libc++ -fsyntax-only %s 2>&1 | FileCheck --check-prefix=SHARED %s
+// SHARED: InstalledDir: [[INSTALLDIR:.+$]]
+// SHARED-NOT: "-internal-isystem" "{{[^"]*}}aarch64-pc-windows-msvc{{/|\\\\}}c++{{/|\\\\}}v1"
+// SHARED: "-internal-isystem" "[[INSTALLDIR]]{{/|\\\\}}..{{/|\\\\}}include{{/|\\\\}}c++{{/|\\\\}}v1"
+
+// Microsoft's STL: by default, with -stdlib=platform, and with -nostdinc++.
+// RUN: %clang -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -fsyntax-only %s 2>&1 | FileCheck --check-prefix=STL %s
+// RUN: %clang -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -stdlib=libc++ -stdlib=platform -fsyntax-only %s 2>&1 | FileCheck --check-prefix=STL %s
+// RUN: %clang_cl -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   /clang:-stdlib=platform /Zs -- %s 2>&1 | FileCheck --check-prefix=STL %s
+// RUN: %clang -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -stdlib=libc++ -nostdinc++ -fsyntax-only %s 2>&1 | FileCheck --check-prefix=STL %s
+// STL-NOT: argument unused during compilation
+// STL-NOT: "-internal-isystem" "{{[^"]*}}c++{{/|\\\\}}v1"
+
+// -stdlib++-isystem stands for libc++'s directories, by default too, and
+// -stdlib=platform takes them away.
+// RUN: %clang -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -stdlib++-isystem /tmp/foo -stdlib++-isystem /tmp/bar -stdlib=libc++ \
+// RUN:   -fsyntax-only %s 2>&1 | FileCheck --check-prefix=ISYSTEM %s
+// RUN: %clang -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -stdlib++-isystem /tmp/foo -stdlib++-isystem /tmp/bar \
+// RUN:   -fsyntax-only %s 2>&1 | FileCheck --check-prefix=ISYSTEM %s
+// ISYSTEM: "-internal-isystem" "/tmp/foo" "-internal-isystem" "/tmp/bar"
+// ISYSTEM-NOT: "-internal-isystem" "{{[^"]*}}c++{{/|\\\\}}v1"
+// RUN: %clang -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   -stdlib++-isystem /tmp/foo -stdlib=libc++ -stdlib=platform \
+// RUN:   -fsyntax-only %s 2>&1 | FileCheck --check-prefix=ISYSTEM-STL %s
+// RUN: %clang_cl -### --target=x86_64-pc-windows-msvc -ccc-install-dir %/t/bin \
+// RUN:   /clang:-stdlib++-isystem/tmp/foo /clang:-stdlib=platform /Zs -- %s 2>&1 \
+// RUN:   | FileCheck --check-prefix=ISYSTEM-STL %s
+// ISYSTEM-STL-NOT: argument unused during compilation
+// ISYSTEM-STL-NOT: "/tmp/foo"
