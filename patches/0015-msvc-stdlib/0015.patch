diff --git a/clang/lib/Driver/ToolChains/MSVC.cpp b/clang/lib/Driver/ToolChains/MSVC.cpp
index 2aa69ec..a4de218 100644
--- a/clang/lib/Driver/ToolChains/MSVC.cpp
+++ b/clang/lib/Driver/ToolChains/MSVC.cpp
@@ -927,9 +927,55 @@ void MSVCToolChain::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
 #endif
 }
 
+// The C++ standard library of MSVC targets is Microsoft's STL, which comes
+// with the C runtime's headers in the include directory of the VC tools
+// (AddClangSystemIncludeArgs). -stdlib=libc++ selects libc++ instead.
+// CLANG_DEFAULT_CXX_STDLIB, the default of the other toolchains, does not
+// change it.
+static bool selectsLibcxx(const ToolChain &TC, const ArgList &Args) {
+  return Args.hasArg(options::OPT_stdlib_EQ) &&
+         TC.GetCXXStdlibType(Args) == ToolChain::CST_Libcxx;
+}
+
 void MSVCToolChain::AddClangCXXStdlibIncludeArgs(const ArgList &DriverArgs,
                                                  ArgStringList &CC1Args) const {
-  // FIXME: There should probably be logic here to find libc++ on Windows.
+  if (DriverArgs.hasArg(options::OPT_nostdinc, options::OPT_nostdlibinc,
+                        options::OPT_nostdincxx) ||
+      !selectsLibcxx(*this, DriverArgs))
+    return;
+
+  // libc++ installed with the compiler, as on other targets: the target's own
+  // headers (its __config_site) in include/<triple>/c++/v1, then the shared
+  // ones in include/c++/v1, both before the headers of the C runtime, which
+  // libc++'s include.
+  SmallString<128> Include(getDriver().Dir);
+  llvm::sys::path::append(Include, "..", "include");
+  std::string Version = detectLibcxxVersion(Include);
+  if (Version.empty())
+    return;
+  if (std::optional<std::string> TargetInclude = getStdlibIncludePath()) {
+    SmallString<128> TargetDir(*TargetInclude);
+    llvm::sys::path::append(TargetDir, "c++", Version);
+    if (getVFS().exists(TargetDir))
+      addSystemInclude(DriverArgs, CC1Args, TargetDir);
+  }
+  llvm::sys::path::append(Include, "c++", Version);
+  addSystemInclude(DriverArgs, CC1Args, Include);
+}
+
+void MSVCToolChain::AddClangCXXStdlibIsystemArgs(const ArgList &DriverArgs,
+                                                 ArgStringList &CC1Args) const {
+  // -stdlib=platform (or any other library than libc++) selects Microsoft's
+  // STL, whose headers are the system's: there is no include directory of a
+  // C++ library for -stdlib++-isystem to stand for. So a configuration file
+  // can give libc++'s with -stdlib=libc++, and -stdlib=platform on the
+  // command line takes them away.
+  if (DriverArgs.hasArg(options::OPT_stdlib_EQ) &&
+      !selectsLibcxx(*this, DriverArgs)) {
+    DriverArgs.ClaimAllArgs(options::OPT_stdlibxx_isystem);
+    return;
+  }
+  ToolChain::AddClangCXXStdlibIsystemArgs(DriverArgs, CC1Args);
 }
 
 VersionTuple MSVCToolChain::computeMSVCVersion(const Driver *D,
