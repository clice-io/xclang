+// Whether the last -stdlib= of the command line, in clang-cl the last
+// /clang:-stdlib=, names another C++ library than libc++.
+static bool selectsPlatformStdlib(const InputArgList &Args, bool CLMode) {
+  StringRef Stdlib;
+  for (const Arg *A : Args) {
+    if (A->getOption().matches(options::OPT_stdlib_EQ)) {
+      Stdlib = A->getValue();
+    } else if (CLMode && A->getOption().matches(options::OPT__SLASH_clang)) {
+      StringRef Value = A->getValue();
+      if (Value.consume_front("-stdlib="))
+        Stdlib = Value;
+    }
+  }
+  return !Stdlib.empty() && Stdlib != "libc++";
+}
