+  // The platform's C++ library, and with it the platform's sysroot or SDK,
+  // in place of the toolchain's own: a -stdlib= of another library than
+  // libc++ (platform, libstdc++) selects <triple>-<mode>-system.cfg or
+  // <triple>-system.cfg where there is one. A configuration file that gives
+  // libc++ with -stdlib++-isystem, -L and --sysroot cannot be undone by
+  // the options that come after it.
+  if (selectsPlatformStdlib(*CLOptions, IsCLMode())) {
+    SmallString<128> SystemCfgPath;
+    if (findTripleConfigFile(ExpCtx, SystemCfgPath, Triple,
+                             "-" + RealMode + "-system.cfg") ||
+        findTripleConfigFile(ExpCtx, SystemCfgPath, Triple, "-system.cfg")) {
+      StdlibSelectedConfig = true;
+      return readConfigFile(SystemCfgPath, ExpCtx);
+    }
+  }
+
   // Search for config files in the following order:
   // 1. <triple>-<mode>.cfg using real driver mode
   //    (e.g. i386-pc-linux-gnu-clang++.cfg).
@@ -1506,6 +1538,11 @@ Compilation *Driver::BuildCompilation(ArrayRef<const char *> ArgList) {
