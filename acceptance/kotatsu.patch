+        allow_empty = True,
+    ),
+    strip_include_prefix = "/tests",
+    textual_hdrs = glob(
+        ["%s/harness/**/*.inc" % module],
+        allow_empty = True,
+    ),
+    deps = deps + ["//:zest"],
+) for module, deps in [
+    ("support", ["//:support"]),
+    ("async", ["//:async"]),
+    ("codec", [
+        ":fixtures",
+        "//:codec",
+    ]),
+    ("codec/bincode", [":codec_harness"]),
+    ("codec/dyn", [":codec_harness"]),
+    ("codec/fbs", [
