+    ("examples/async", "unit", [
+        ":async_harness",
+        "//examples:build_system_graph",
+    ], []),
+]]
+
+# The integration tests' drivers: integration/drivers/<name>.cpp of a module.
+[kota_binary(
+    name = driver,
+    srcs = ["%s/integration/drivers/%s.cpp" % (module, driver)],
