+        exclude = [
+            "benchmarks/**",
+            "conformance/**",
+        ],
+    ) + [
+        "//:package-lock.json",
+        "//:package.json",
+    ],
+    env = {
+        "KOTA_" + program.split(":")[-1].upper(): "$(rootpath %s)" % program
+        for program in programs
+    },
+    source_tree = True,
+    tags = ["integration"],
+) for module, programs, exclude in [
+    ("ipc", [
+        ":jsonrpc_driver",
+        ":stdio_close",
+    ], []),
+    # roundtrip.test.ts needs lsp_roundtrip, a debug build's only.
+    ("ipc/lsp", [
+        ":lsp_probe",
+        ":lsp_stub_server",
+    ], ["ipc/lsp/integration/roundtrip.test.ts"]),
+    ("examples/async", [
