+        strip_prefix = "cpptrace-1.0.4",
+    )
+    _github(
+        name = "flatbuffers",
+        repo = "google/flatbuffers",
+        tag = "v25.2.10",
+        sha256 = "b9c2df49707c57a48fc0923d52b8c73beb72d675f9d44b2211e4569be40a7421",
+        strip_prefix = "flatbuffers-25.2.10",
+    )
+    _github(
+        name = "libuv",
+        repo = "libuv/libuv",
+        tag = "v1.52.0",
+        sha256 = "eee139c05f7c868f5ae7a54b1e155fd5b6ed13a22329958d2ba711faad016353",
+        strip_prefix = "libuv-1.52.0",
+    )
+    _github(
+        name = "simdjson",
+        repo = "simdjson/simdjson",
+        tag = "v4.2.4",
+        sha256 = "6f942d018561a6c30838651a386a17e6e4abbfc396afd0f62740dea1810dedea",
+        strip_prefix = "simdjson-4.2.4",
+    )
+    _github(
+        name = "tomlplusplus",
+        repo = "marzer/tomlplusplus",
+        tag = "v3.4.0",
+        sha256 = "8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155",
+        strip_prefix = "tomlplusplus-3.4.0",
+    )
+    return mctx.extension_metadata(reproducible = True)
+
+kotatsu_deps = module_extension(implementation = _kotatsu_deps_impl)
