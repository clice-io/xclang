+    tags = ["manual"] if driver == "lsp_roundtrip" else [],
+    deps = deps,
+) for module, deps, drivers in [
+    ("ipc", [":ipc_harness"], [
+        "jsonrpc_driver",
+        "stdio_close",
+    ]),
+    ("ipc/lsp", [
+        ":ipc_harness",
+        ":ipc_lsp_harness",
+    ], [
+        "lsp_probe",
+        "lsp_roundtrip",
+        "lsp_stub_server",
+    ]),
+] for driver in drivers]
