+    ("support", "unit", [":support_harness"], []),
+    ("meta", "unit", [":fixtures"], []),
+    ("codec", "unit", [":codec_harness"], []),
+    ("codec/bincode", "unit", [":codec_bincode_harness"], []),
+    ("codec/debug", "unit", [":codec_harness"], []),
+    ("codec/dyn", "unit", [":codec_dyn_harness"], []),
+    ("codec/fbs", "unit", [":codec_fbs_harness"], []),
+    ("codec/json", "unit", [":codec_json_harness"], []),
+    ("codec/toml", "unit", [":codec_toml_harness"], []),
+    ("deco", "unit", [":deco_harness"], []),
+    ("async", "unit", [":async_harness"], []),
+    ("async", "system", [":async_harness"], []),
+    ("ipc", "unit", [":ipc_harness"], []),
+    ("ipc", "system", [":ipc_harness"], []),
+    ("ipc/lsp", "unit", [
