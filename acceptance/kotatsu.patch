+        name = name,
+        build_file = Label("//bazel/third_party:%s.BUILD" % name),
+        sha256 = sha256,
+        strip_prefix = strip_prefix,
+        urls = ["https://github.com/%s/archive/refs/tags/%s.tar.gz" % (repo, tag)],
+    )
+
+def _kotatsu_deps_impl(mctx):
+    _github(
+        name = "cpptrace",
+        repo = "jeremy-rifkin/cpptrace",
+        tag = "v1.0.4",
