new file mode 100644
index 0000000..89c67c2
--- /dev/null
+++ b/MODULE.bazel
@@ -0,0 +1,30 @@
+module(
+    name = "kotatsu",
+    version = "0.1.0",
+)
+
+bazel_dep(name = "bazel_skylib", version = "1.9.0")
+bazel_dep(name = "platforms", version = "1.0.0")
+bazel_dep(name = "rules_cc", version = "0.2.25")
+
+# zest's stack traces (cpptrace) read DWARF on Linux and macOS.
+bazel_dep(name = "libdwarf", version = "2.2.0.bcr.1")
+
+# Every other third-party library comes from its release archive with a BUILD
+# file of kotatsu's (bazel/third_party), at the versions the CMake build pins.
+# They are an extension's repos so that a module depending on kotatsu can
+# use_repo the same ones rather than link a second copy.
+kotatsu_deps = use_extension("//bazel:extensions.bzl", "kotatsu_deps")
+use_repo(
+    kotatsu_deps,
+    "cpptrace",
+    "flatbuffers",
+    "libuv",
+    "simdjson",
+    "tomlplusplus",
+)
+
+# The C++ toolchain on every platform: xclang's module, which downloads the
+# release of its version for the host. Development only: a module depending
+# on kotatsu brings its own toolchain.
+bazel_dep(name = "xclang", version = "23.1.2.4", dev_dependency = True)
