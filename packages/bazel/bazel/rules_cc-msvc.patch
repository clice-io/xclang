+def _crt(runtime, features, not_features = []):
+    """-fms-runtime-lib=<runtime> in compiles and links, with features and not not_features."""
+    return flag_set(
+        actions = all_compile_actions + all_link_actions,
+        flag_groups = [flag_group(flags = ["-fms-runtime-lib=" + runtime])],
+        with_features = [with_feature_set(features = features, not_features = not_features)],
+    )
+
+def _msvc_features():
+    """The MSVC targets' own features: the PDB of a link
+    (generate_pdb_file, which cc_binary declares <name>.pdb for), the VC
+    runtime as DLLs (dynamic_link_msvcrt, /MD) and the debug CRT
+    (debug_msvcrt, /MTd or /MDd) in place of the hybrid CRT the config
+    files have (the VC runtime linked in, UCRT's DLL), and Microsoft's STL
+    in place of libc++ (msvc_stl)."""
+    return [
+        feature(
+            name = "msvc_stl",
+            flag_sets = [
+                flag_set(
+                    actions = all_cpp_compile_actions + all_link_actions,
+                    flag_groups = [flag_group(flags = ["-stdlib=platform"])],
+                ),
+            ],
+        ),
+        feature(
+            name = "generate_pdb_file",
+            flag_sets = [
+                flag_set(
+                    actions = all_link_actions,
+                    flag_groups = [flag_group(flags = [
+                        "-Wl,/debug",
+                        # The PDB by its name only in the program, and the
+                        # sources by their paths from the execution root:
+                        # the same files wherever the build ran.
+                        "-Wl,/pdbaltpath:%%_PDB%%",
+                        "-Wl,/pdbsourcepath:.",
+                    ])],
+                ),
+            ],
+        ),
+        feature(
+            name = "dynamic_link_msvcrt",
+            flag_sets = [
+                _crt("dll", ["dynamic_link_msvcrt"], ["debug_msvcrt"]),
+            ],
+        ),
+        feature(
+            name = "debug_msvcrt",
+            flag_sets = [
+                _crt("dll_dbg", ["dynamic_link_msvcrt"]),
+                _crt("static_dbg", [], ["dynamic_link_msvcrt"]),
+                # Without UCRT's import library, which the config files'
+                # hybrid CRT names in every object: the debug CRT is
+                # ucrtbased.dll's. Only an option of the link comes before
+                # the objects' own.
+                flag_set(
+                    actions = all_link_actions,
+                    flag_groups = [flag_group(flags = ["-Wl,/nodefaultlib:ucrt.lib"])],
+                ),
+            ],
+        ),
+    ]
+
