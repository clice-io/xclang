load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load(":hosts.bzl", "TARGETS", "constraints", "host_of")

exports_files(glob(["*.bzl", "*.patch"]))

# The machine's toolchain, which @platforms//host, the default execution
# platform, selects.
HOST = host_of(HOST_CONSTRAINTS)

# lld's --gc-sections in optimized builds, as a feature: on by default for
# Linux targets, off for Windows ones, where lld drops the static initializers
# of COMDAT sections with it (test registrations); --features=gc_sections
# (or features = ["gc_sections"]) turns it on there, -gc_sections off.
cc_feature(
    name = "gc_sections",
    args = [":gc_sections_args"],
    feature_name = "gc_sections",
    requires_any_of = ["@rules_cc//cc/toolchains/features:opt"],
    visibility = ["//visibility:public"],
)

cc_args(
    name = "gc_sections_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-Wl,--gc-sections"],
)

# The same for the MSVC targets, lld-link's /opt:ref, which their links
# otherwise turn off (bazel/toolchain.bzl): lld-link does it by default
# without /debug, ICF too.
cc_feature(
    name = "gc_sections_msvc",
    args = [":gc_sections_msvc_args"],
    feature_name = "gc_sections",
    requires_any_of = ["@rules_cc//cc/toolchains/features:opt"],
    visibility = ["//visibility:public"],
)

cc_args(
    name = "gc_sections_msvc_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-Wl,/opt:ref"],
)

# A release's strip (cc_binary's <name>.stripped; --stripopt adds to it), by
# the target's object format, on by default (bazel/toolchain.bzl): an ELF or
# COFF program loses its debug information and the symbols no relocation
# needs; a Mach-O one every symbol dyld does not bind, as Apple's strip does,
# its global functions too, whose names dladdr would otherwise give to the
# addresses of the local ones in a crash log.
cc_feature(
    name = "strip_unneeded",
    args = [":strip_unneeded_args"],
    feature_name = "release_strip",
    visibility = ["//visibility:public"],
)

cc_args(
    name = "strip_unneeded_args",
    actions = ["@rules_cc//cc/toolchains/actions:strip"],
    args = ["--strip-unneeded"],
)

cc_feature(
    name = "strip_all",
    args = [":strip_all_args"],
    feature_name = "release_strip",
    visibility = ["//visibility:public"],
)

cc_args(
    name = "strip_all_args",
    actions = ["@rules_cc//cc/toolchains/actions:strip"],
    args = ["--strip-all"],
)

# An optimized macOS program exports nothing, as a feature on by default
# (bazel/toolchain.bzl): a C++ program exports its weak definitions (template
# instantiations, inline functions) for dyld to coalesce, strip keeps every
# symbol dyld binds, and dladdr names a crash log's frames after the nearest
# of them. A program whose plugins bind to its symbols turns it off:
# --features=-no_exported_symbols (or features = ["-no_exported_symbols"]).
cc_feature(
    name = "no_exported_symbols",
    args = [":no_exported_symbols_args"],
    feature_name = "no_exported_symbols",
    requires_any_of = ["@rules_cc//cc/toolchains/features:opt"],
    visibility = ["//visibility:public"],
)

cc_args(
    name = "no_exported_symbols_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_link_executable"],
    args = ["-Wl,-no_exported_symbols"],
)

# A module interface's file embeds its sources, as a feature on by default
# (bazel/toolchain.bzl): an importer reads them with -g (the partition a
# primary interface imports, say), and in the sandbox it has the module
# file but not the source ("cannot open file 'x.cppm'").
cc_feature(
    name = "modules_embed_all_files",
    args = [":modules_embed_all_files_args"],
    feature_name = "modules_embed_all_files",
    visibility = ["//visibility:public"],
)

cc_args(
    name = "modules_embed_all_files_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp20_module_compile"],
    args = ["-Xclang", "-fmodules-embed-all-files"],
)

# llvm-gsymutil of the machine's toolchain, to read the GSYM of
# xclang_debug_symbols (bazel/debug_symbols.bzl) without the toolchain on
# PATH: bazel run @xclang//bazel:llvm-gsymutil -- <absolute .gsym>
# --address=0x... It is llvm, the toolchain's program of many names, by that
# name: a link to it, or on Windows without links a copy.
[
    native_binary(
        name = "llvm-gsymutil",
        src = "@xclang_%s//:bin/llvm%s" % (host, exe),
        out = "llvm-gsymutil" + exe,
        visibility = ["//visibility:public"],
    )
    for host in ([HOST] if HOST else [])
    for exe in [".exe" if TARGETS[host].os == "windows" else ""]
]

# import std and import std.compat: libc++'s modules of the target platform,
# from the host's toolchain (bazel/toolchain.bzl). A target importing them
# depends on this and has the cpp_modules feature.
alias(
    name = "std",
    actual = select(
        {":" + target: "@xclang_%s//:std_%s" % (HOST or target, target) for target in TARGETS},
        no_match_error = "xclang has no toolchain for the target platform",
    ),
    visibility = ["//visibility:public"],
)

# The target platforms of xclang's toolchains, by triple: an MSVC target's
# is a specialization of the MinGW target's of its cpu, which select()
# prefers.
[
    config_setting(
        name = target,
        constraint_values = constraints(target),
    )
    for target in TARGETS
]

# What has no build for the target platform (@libclang for the MSVC
# targets): its dependents are incompatible, skipped by //... .
cc_library(
    name = "none",
    target_compatible_with = ["@platforms//:incompatible"],
    visibility = ["//visibility:public"],
)

# Microsoft's STL in place of libc++ for the MSVC targets, a feature of the
# whole build (--features=msvc_stl), which @xclang//bazel:std follows
# (bazel/toolchain.bzl): a module's importers take the options it was built
# with.
config_setting(
    name = "msvc_stl",
    values = {"features": "msvc_stl"},
)

# The same with --features=asan, which @libclang follows (bazel/libclang.bzl).
[
    config_setting(
        name = target + "-asan",
        constraint_values = constraints(target),
        values = {"features": "asan"},
    )
    for target in TARGETS
]
