load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load(":hosts.bzl", "TARGETS", "constraints", "host_of")

exports_files(glob(["*.bzl", "*.patch"]))

# The machine's toolchain, which @platforms//host, the default execution
# platform, selects.
HOST = host_of(HOST_CONSTRAINTS)

# lld's --gc-sections in optimized builds, as a feature: on by default for
# Linux targets, off for Windows ones, where lld drops the static initializers
# of COMDAT sections with it (test registrations); --features=gc_sections
# (or features = ["gc_sections"]) turns it on there, -gc_sections off.
cc_feature(
    name = "gc_sections",
    args = [":gc_sections_args"],
    feature_name = "gc_sections",
    requires_any_of = ["@rules_cc//cc/toolchains/features:opt"],
    visibility = ["//visibility:public"],
)

cc_args(
    name = "gc_sections_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-Wl,--gc-sections"],
)

# A release's strip (cc_binary's <name>.stripped; --stripopt adds to it), by
# the target's object format, on by default (bazel/toolchain.bzl): an ELF or
# COFF program loses its debug information and the symbols no relocation
# needs; a Mach-O one every symbol dyld does not bind, as Apple's strip does,
# its global functions too, whose names dladdr would otherwise give to the
# addresses of the local ones in a crash log.
cc_feature(
    name = "strip_unneeded",
    args = [":strip_unneeded_args"],
    feature_name = "release_strip",
    visibility = ["//visibility:public"],
)

cc_args(
    name = "strip_unneeded_args",
    actions = ["@rules_cc//cc/toolchains/actions:strip"],
    args = ["--strip-unneeded"],
)

cc_feature(
    name = "strip_all",
    args = [":strip_all_args"],
    feature_name = "release_strip",
    visibility = ["//visibility:public"],
)

cc_args(
    name = "strip_all_args",
    actions = ["@rules_cc//cc/toolchains/actions:strip"],
    args = ["--strip-all"],
)

# import std and import std.compat: libc++'s modules of the target platform,
# from the host's toolchain (bazel/toolchain.bzl). A target importing them
# depends on this and has the cpp_modules feature.
alias(
    name = "std",
    actual = select(
        {":" + target: "@xclang_%s//:std_%s" % (HOST or target, target) for target in TARGETS},
        no_match_error = "xclang has no toolchain for the target platform",
    ),
    visibility = ["//visibility:public"],
)

# The target platforms of xclang's toolchains, by triple.
[
    config_setting(
        name = target,
        constraint_values = constraints(target),
    )
    for target in TARGETS
]
