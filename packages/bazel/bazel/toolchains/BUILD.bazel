load("@xclang_sdks//:sdks.bzl", "SDKS")
load("//bazel:hosts.bzl", "HOSTS", "OTHER_LIBCS", "TARGETS", "builds", "constraints")
load("//bazel:unsupported.bzl", "xclang_unsupported_toolchain")

# The C++ toolchain of every host for every target: <host> compiles for the
# host itself, <host>-to-<target> for another target (--platforms,
# //platforms). Each is the toolchain of the host's archive configured for
# the target, and only the one of the machine is fetched
# (bazel/repositories.bzl). Those of musl and of the MSVC targets are in
# musl/ and msvc/, registered first.
[
    toolchain(
        name = host if host == target else "%s-to-%s" % (host, target),
        exec_compatible_with = constraints(host),
        target_compatible_with = constraints(target),
        toolchain = "@xclang_%s//:cc_%s" % (host, target) if builds(host, target, SDKS) else ":no-macos-sdk",
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    )
    for host in HOSTS
    for target in TARGETS
    if TARGETS[target].libc not in OTHER_LIBCS
]

# The macOS targets from another host without Apple's SDK: a build for them
# fails with why, rather than with a compiler's error or no toolchain at all.
xclang_unsupported_toolchain(
    name = "no-macos-sdk",
    message = ("xclang builds for macOS off macOS hosts with Apple's SDK, which the root module fetches " +
               "with xclang.macos_sdk(accept_license = True) in its MODULE.bazel " +
               "(https://docs.clice.io/xclang/integrations/bazel#vendor-sdks)"),
)
