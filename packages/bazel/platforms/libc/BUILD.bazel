# The C library a target links, as rules_cc's target_libc names it: for
# select(), and so that another C library of an os and cpu (musl, MSVC's) can
# have toolchains of its own. The toolchains here ask only for os and cpu, so
# a platform without this constraint gets glibc on Linux and MinGW on Windows.
constraint_setting(
    name = "libc",
    visibility = ["//visibility:public"],
)

# glibc 2.17 (Linux).
constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

# MinGW-w64 on UCRT (Windows).
constraint_value(
    name = "mingw",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

# libSystem (macOS).
constraint_value(
    name = "macosx",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)
