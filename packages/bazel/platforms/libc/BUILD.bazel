load("@xclang_machine//:machine.bzl", "LIBC")

# The C library a target links, as rules_cc's target_libc names it (but
# MSVC's): for select(), and so that another C library of an os and cpu can
# have toolchains of its own. Those of musl and MSVC's ask a platform for it
# (bazel/toolchains/musl, msvc), the others only for os and cpu. A platform
# without this constraint has the machine's Linux C library (@xclang_machine,
# bazel/hosts.bzl): glibc, and so gets glibc on Linux and MinGW on Windows;
# on a musl machine (Alpine) musl, and so its host platform, the default
# target and execution platform, builds static musl programs with the musl
# host's toolchain: a Linux host's toolchain asks the execution platform for
# its C library (bazel/hosts.bzl, exec_constraints).
constraint_setting(
    name = "libc",
    default_constraint_value = ":musl" if LIBC == "musl" else ":glibc",
    visibility = ["//visibility:public"],
)

# glibc 2.17 (Linux).
constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

# musl (Linux): static programs. Its toolchains ask a platform for it.
constraint_value(
    name = "musl",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

# MinGW-w64 on UCRT (Windows).
constraint_value(
    name = "mingw",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

# libSystem (macOS).
constraint_value(
    name = "macosx",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

# Microsoft's CRT on UCRT, the MSVC targets' (Windows), whose toolchains ask
# for it; rules_cc's target_libc is msvcrt.
constraint_value(
    name = "msvc",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)
