load("//bazel:hosts.bzl", "OTHER_LIBCS", "SPELLINGS", "TARGETS", "constraints")

# A platform per target, named by its triple, for --platforms: its os and cpu,
# all the toolchains ask of a platform, and its C library (libc/BUILD.bazel),
# which those of musl and of the MSVC targets ask for too (constraints). The
# macOS targets build off macOS hosts, and the MSVC targets anywhere, with
# the vendor's SDK.
[
    platform(
        name = triple,
        constraint_values = constraints(triple) + ([] if t.libc in OTHER_LIBCS else ["//platforms/libc:" + t.libc]),
        visibility = ["//visibility:public"],
    )
    for triple, t in TARGETS.items()
]

# Other spellings of the triples (bazel/hosts.bzl).
[
    alias(
        name = spelling,
        actual = ":" + triple,
        visibility = ["//visibility:public"],
    )
    for spelling, triple in SPELLINGS.items()
]
