load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Not for musl, whose programs are static and load no library.
MUSL_INCOMPATIBLE = select({
    "@xclang//platforms/libc:musl": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# A shared library asked for by name, with libc++ inside: libplugin.so,
# libplugin.dylib, plugin.dll.
cc_binary(
    name = "plugin",
    srcs = ["plugin.cpp"],
    linkshared = True,
    target_compatible_with = MUSL_INCOMPATIBLE,
)

cc_test(
    name = "shared_test",
    srcs = ["shared_test.cpp"],
    args = ["$(rootpath :plugin)"],
    data = [":plugin"],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    target_compatible_with = MUSL_INCOMPATIBLE,
)
