"""The xclang module's tests: the toolchain, libclang and the option tables
as a consumer uses them, from the module in this checkout (packages/bazel)."""

module(name = "xclang_tests")

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "xclang", version = "23.1.2.6")
local_path_override(
    module_name = "xclang",
    path = "../../packages/bazel",
)

xclang = use_extension("@xclang//bazel:extensions.bzl", "xclang")
use_repo(xclang, "libclang", "libclang_asan", "llvm_option_inc")

# Sources of another repository, which tests/bazel.ts's debuggers find under
# bazel-<workspace>/external/.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "greeter",
    build_file_content = """\
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "greeter",
    srcs = ["greeter.cpp"],
    hdrs = ["greeter.h"],
    visibility = ["//visibility:public"],
)
""",
    path = "third_party/greeter",
)
