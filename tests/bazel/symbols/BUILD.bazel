load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@xclang//bazel:debug_symbols.bzl", "xclang_debug_symbols")

# Debug symbols, which tests/bazel/bazel.ts builds and checks: a program's GSYM,
# and on macOS the dSYM its link makes. Manual: they need --strip=never in
# fastbuild, which otherwise strips the programs of their DWARF.
cc_binary(
    name = "hello",
    srcs = ["hello.cpp"],
    copts = ["-g"],
    features = ["generate_dsym_file"],
)

xclang_debug_symbols(
    name = "hello_symbols",
    binary = ":hello",
    tags = ["manual"],
)

# The same, linked with identical code folding: twin_a and twin_b, merged,
# both in the GSYM (--merged-functions) and, on macOS, in the dSYM.
cc_binary(
    name = "hello_icf",
    srcs = ["hello.cpp"],
    copts = [
        "-g",
        "-ffunction-sections",
    ],
    features = ["generate_dsym_file"],
    linkopts = ["-Wl,--icf=all"],
)

xclang_debug_symbols(
    name = "hello_icf_symbols",
    binary = ":hello_icf",
    gsymutil_args = ["--merged-functions"],
    tags = ["manual"],
)

# A tool on libclang, whose code ThinLTO generates in the link: its debug
# information reaches the dSYM and the GSYM too.
cc_binary(
    name = "lexer",
    srcs = ["//libclang:main.cpp"],
    copts = [
        "-fno-rtti",
        "-g",
    ],
    features = ["generate_dsym_file"],
    deps = [
        "@libclang//:clangBasic",
        "@libclang//:clangLex",
        "@libclang//:LLVMSupport",
    ],
)

xclang_debug_symbols(
    name = "lexer_symbols",
    binary = ":lexer",
    tags = ["manual"],
)

# A library whose objects share names, as a module's do: a partition and an
# implementation unit (logging.cppm, logging.cpp), and one name in two
# directories (a/types.cpp, b/types.cpp). Each one's lines are in the GSYM,
# and on macOS in the dSYM: in an archive, two objects of one name are
# libunits.a(logging.o) alike, which dsymutil tells apart by name and time.
# The BMIs carry their sources: the sandbox of an importer has none, which
# the debug information of an optimized compile reads.
cc_library(
    name = "units",
    srcs = [
        "units/a/types.cpp",
        "units/b/types.cpp",
        "units/logging.cpp",
    ],
    copts = [
        "-g",
        "-Xclang",
        "-fmodules-embed-all-files",
    ],
    features = ["cpp_modules"],
    module_interfaces = [
        "units/logging.cppm",
        "units/units.cppm",
    ],
)

cc_binary(
    name = "units_main",
    srcs = ["units_main.cpp"],
    copts = ["-g"],
    features = [
        "cpp_modules",
        "generate_dsym_file",
    ],
    deps = [":units"],
)

xclang_debug_symbols(
    name = "units_symbols",
    binary = ":units_main",
    tags = ["manual"],
)
