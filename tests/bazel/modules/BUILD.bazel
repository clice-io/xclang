load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# C++20 modules: a module of partitions, a module of another library that
# imports it, and a test importing both. Bazel scans each with
# clang-scan-deps (P1689) for the order to compile them in.
cc_library(
    name = "math",
    features = ["cpp_modules"],
    module_interfaces = [
        "math.cppm",
        "math-ops.cppm",
    ],
)

cc_library(
    name = "greeting",
    features = ["cpp_modules"],
    module_interfaces = ["greeting.cppm"],
    deps = [":math"],
)

cc_test(
    name = "modules_test",
    srcs = ["main.cpp"],
    features = ["cpp_modules"],
    deps = [
        ":greeting",
        ":math",
    ],
)

# A library's defines reach the module units depending on it, and the scans
# of them: configured.cppm stops at an #error without.
cc_library(
    name = "config",
    defines = ["XCLANG_TEST_CONFIGURED=1"],
)

cc_library(
    name = "configured",
    features = ["cpp_modules"],
    module_interfaces = ["configured.cppm"],
    deps = [":config"],
)

# import std and import std.compat, libc++'s modules built for the target.
cc_library(
    name = "shapes",
    features = ["cpp_modules"],
    module_interfaces = ["shapes.cppm"],
    deps = ["@xclang//bazel:std"],
)

cc_test(
    name = "std_test",
    srcs = ["std.cpp"],
    features = ["cpp_modules"],
    deps = [
        ":shapes",
        "@xclang//bazel:std",
    ],
)
