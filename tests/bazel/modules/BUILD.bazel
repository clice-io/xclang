load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# C++20 modules: a module of partitions, a module of another library that
# imports it, and a test importing both. Bazel scans each with
# clang-scan-deps (P1689) for the order to compile them in.
cc_library(
    name = "math",
    features = ["cpp_modules"],
    module_interfaces = [
        "math.cppm",
        "math-ops.cppm",
    ],
)

cc_library(
    name = "greeting",
    features = ["cpp_modules"],
    module_interfaces = ["greeting.cppm"],
    deps = [":math"],
)

cc_test(
    name = "modules_test",
    srcs = ["main.cpp"],
    features = ["cpp_modules"],
    deps = [
        ":greeting",
        ":math",
    ],
)
