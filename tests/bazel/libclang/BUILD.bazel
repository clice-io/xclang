load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@xclang//bazel:resource_dir.bzl", "xclang_resource_dir")

exports_files(["main.cpp"])

# A tool on libclang, as tests/libclang is for CMake: the libraries it names
# bring the rest of their link interface (packages/bazel/bazel/libclang.bzl).
# libclang is ThinLTO bitcode, linked by the lld of the same release.
LIBRARIES = [
    "clangBasic",
    "clangLex",
    "LLVMSupport",
]

cc_test(
    name = "libclang_test",
    srcs = ["main.cpp"],
    copts = ["-fno-rtti"],
    deps = ["@libclang//:" + lib for lib in LIBRARIES],
)

# Every target's MC layer, registered and looked up by triple
# (tests/libclang's targets.cpp); skipped with archives that have not every
# target's (@libclang//:AllTargetsInfos and the like are incompatible).
cc_test(
    name = "targets_test",
    srcs = ["targets.cpp"],
    copts = ["-fno-rtti"],
    deps = [
        "@libclang//:AllTargetsAsmParsers",
        "@libclang//:AllTargetsDescs",
        "@libclang//:AllTargetsDisassemblers",
        "@libclang//:AllTargetsInfos",
        "@libclang//:LLVMMC",
        "@libclang//:LLVMSupport",
        "@libclang//:LLVMTargetParser",
    ],
)

# The ASan build with assertions, published for Linux x64 and macOS arm64.
cc_test(
    name = "libclang_asan_test",
    srcs = ["main.cpp"],
    copts = ["-fno-rtti"],
    features = ["asan"],
    target_compatible_with = select({
        ":linux_x86_64": [],
        ":macos_aarch64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@libclang_asan//:" + lib for lib in LIBRARIES],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

# clang's resource directory where a tool on libclang looks for it, next to
# bin/: the test asks clang for it from its own executable's path.
cc_test(
    name = "bin/resource_dir_test",
    srcs = ["resource_dir.cpp"],
    copts = ["-fno-rtti"],
    data = [":resource_dir"],
    deps = ["@libclang//:" + lib for lib in LIBRARIES + ["clangOptions"]],
)

xclang_resource_dir(name = "resource_dir")
